page.headerData {
    1 = COA
    1 {
        10 = TEXT
        10 {
            value = {$plugin.tx_nscookiebot_nscookiebot.settings.cookieapikey}
            htmlSpecialChars = 1
            wrap = <script id="Cookiebot" src="https://consent.cookiebot.com/uc.js" data-cbid="|" type="text/javascript" async></script>
            if {
                value = {$plugin.tx_nscookiebot_nscookiebot.settings.cookieapiasync}
                equals = 1
            }
        }
        20 = TEXT
        20 {
            value = {$plugin.tx_nscookiebot_nscookiebot.settings.cookieapikey}
            htmlSpecialChars = 1
            wrap = <script id="Cookiebot" src="https://consent.cookiebot.com/uc.js" data-cbid="|" type="text/javascript" data-blockingmode="auto"></script>
            if {
                value = {$plugin.tx_nscookiebot_nscookiebot.settings.cookieapiasync}
                equals = 1
                negate = 1
            }
        }
    }
}
